{
  "name": "forge-platform",
  "version": "6.92.0",
  "description": "Forge - Full production AI platform",
  "main": "src/index.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon --exec 'ts-node --transpile-only src/index.ts'",
    "build": "esbuild src/index.ts src/sandbox-contract.ts --bundle=false --platform=node --target=node18 --format=cjs --outdir=dist",
    "start": "node dist/index.js",
    "test": "jest --testPathPattern='__tests__/(auth|route-manifest)' --forceExit --no-coverage",
    "test:routes": "jest --testPathPattern=route-manifest --forceExit --no-coverage",
    "test:deployment-provider": "node scripts/deployment-provider-regression.cjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "orchestration"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/node-cron": "^3.0.11",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "graphql": "^16.8.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "papaparse": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.2",
    "typescript": "5.4.5",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "esbuild": "^0.19.0"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "socket.io-parser": "4.2.7",
    "ws": "8.21.3"
  }
}
