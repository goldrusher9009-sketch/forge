{
  "name": "forge-platform",
  "version": "6.92.0",
  "description": "Forge - Full production AI platform",
  "main": "src/index.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon --exec 'ts-node --transpile-only src/index.ts'",
    "build": "echo 'no build — start runs ts-node on source'",
    "start": "ts-node --transpile-only src/index.ts",
    "test": "jest --testPathPattern='__tests__/(auth|route-manifest)' --forceExit --no-coverage",
    "test:routes": "jest --testPathPattern=route-manifest --forceExit --no-coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "orchestration"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/node-cron": "^3.0.11",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "graphql": "^16.8.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "papaparse": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.7.4",
    "ts-node": "^10.9.2",
    "typescript": "5.4.5",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  }
}
