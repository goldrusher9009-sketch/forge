PORT=3000
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret-32-chars-minimum
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-admin-password
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-key
FRONTEND_URL=https://your-vercel-app.vercel.app
DB_PATH=/data/forge.db

# Keep false for local development. A commercial release must set this to true;
# startup and /ready then fail closed unless the complete Stripe contract exists.
BILLING_REQUIRED=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_AGENCY=price_replace_me
