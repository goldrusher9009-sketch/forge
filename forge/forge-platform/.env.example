PORT=3000
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret-32-chars-minimum
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-admin-password
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-key
FRONTEND_URL=https://your-vercel-app.vercel.app
DB_PATH=/data/forge.db

# Sandbox control plane. Keep the Orchestrator private and use a distinct
# high-entropy HMAC secret; never expose the Orchestrator directly to browsers.
FORGE_SANDBOX_ORCHESTRATOR_URL=http://forge-sandbox-orchestrator:3001
FORGE_SANDBOX_HMAC_SECRET=replace-with-a-separate-high-entropy-hmac-secret

# Google Drive OAuth + Picker. The client secret belongs only in the backend
# secret store. Restrict the Picker key to the exact frontend referrer and the
# Google Picker API before using it outside local development.
GOOGLE_DRIVE_CLIENT_ID=replace-with-google-oauth-web-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-google-oauth-web-client-secret
GOOGLE_DRIVE_REDIRECT_URI=https://your-backend.example/api/google-drive/oauth/callback
GOOGLE_DRIVE_DEVELOPER_KEY=replace-with-restricted-google-picker-key
GOOGLE_DRIVE_APP_ID=replace-with-google-cloud-project-number

# Keep false for local development. A commercial release must set this to true;
# startup and /ready then fail closed unless the complete Stripe contract exists.
BILLING_REQUIRED=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_AGENCY=price_replace_me
