{
	admin off
	email {$ACME_EMAIL}
}

{$FORGE_CONTROL_PLANE_DOMAIN} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	request_body {
		max_size 16MB
	}

	@vercel_gateway {
		path /api/*
		header X-Forge-Gateway-Secret {$FORGE_CONTROL_PLANE_GATEWAY_SECRET}
	}

	handle @vercel_gateway {
		reverse_proxy forge-platform:3000 {
			flush_interval -1
			header_up -X-Forge-Gateway-Secret
		}
	}

	respond 404
}
