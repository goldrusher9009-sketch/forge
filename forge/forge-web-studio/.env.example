# Browser requests always use the Vercel same-origin gateway.
NEXT_PUBLIC_API_BASE_URL=/api

# Server-only upstream used by the Vercel gateway. Never prefix this with
# NEXT_PUBLIC_. Local Compose exposes Forge at http://127.0.0.1:3401/api/;
# Vercel Preview/Production must use an external HTTPS control plane.
FORGE_CONTROL_PLANE_API_URL=http://127.0.0.1:3401/api/
NEXT_PUBLIC_ENABLE_AGENT_CREATION=true
NEXT_PUBLIC_ENABLE_WORKFLOW_CREATION=true
NEXT_PUBLIC_ENABLE_QUEUE_MONITORING=true
NEXT_PUBLIC_ENABLE_HISTORY_TRACKING=true
