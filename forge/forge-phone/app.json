{
  "expo": {
    "name": "Forge Phone Agent",
    "slug": "forge-phone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "android": {
      "package": "com.forge.phoneagent",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "BIND_ACCESSIBILITY_SERVICE",
        "SYSTEM_ALERT_WINDOW",
        "RECEIVE_SMS",
        "READ_SMS",
        "READ_CONTACTS",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.forge.phoneagent",
      "infoPlist": {
        "NSCameraUsageDescription": "Forge needs camera to capture screen for AI analysis",
        "NSPhotoLibraryUsageDescription": "Forge needs photo library to save screenshots"
      }
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow Forge to access the camera for screen analysis" }]
    ]
  }
}
