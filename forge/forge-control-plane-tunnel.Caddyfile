{
	admin off
	auto_https off
}

:8080 {
	# No compression here: the Vercel proxy forwards bodies verbatim and Vercel's edge compresses.

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	request_body {
		max_size 16MB
	}

	# Unauthenticated liveness for the container healthcheck and host nginx.
	respond /healthz 200

	# Stripe calls this directly; it is authenticated by the Stripe-Signature header
	# (verified with STRIPE_WEBHOOK_SECRET inside the platform), not by the gateway secret.
	@stripe_webhook {
		method POST
		path /api/billing/webhook
		header Stripe-Signature *
	}
	handle @stripe_webhook {
		reverse_proxy forge-platform:3000 {
			flush_interval -1
			header_up -X-Forge-Gateway-Secret
		}
	}

	@vercel_gateway {
		path /api/*
		header X-Forge-Gateway-Secret {$FORGE_CONTROL_PLANE_GATEWAY_SECRET}
	}

	handle @vercel_gateway {
		reverse_proxy forge-platform:3000 {
			flush_interval -1
			header_up -X-Forge-Gateway-Secret
		}
	}

	respond 404
}
